{
  "name": "orbit-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@clerk/expo": "^4.8.1",
    "@expo-google-fonts/hanken-grotesk": "^0.4.3",
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo/config-plugins": "^57.0.9",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "expo": "~57.0.26",
    "expo-apple-authentication": "~57.0.2",
    "expo-auth-session": "~57.0.13",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "firebase": "^11.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-appwrite": "^0.34.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.33",
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.2.4",
    "sharp": "^0.34.3",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "generate:icons": "node scripts/generate-brand-assets.mjs",
    "start": "expo start --go --lan",
    "start:tunnel": "expo start --tunnel --go",
    "android": "expo start --android",
    "android:prebuild": "expo prebuild --platform android",
    "android:run": "expo run:android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:guest": "playwright test e2e/hyd.spec.ts e2e/app.spec.ts e2e/employer.spec.ts e2e/admin.spec.ts e2e/api.spec.ts",
    "test:e2e:install": "playwright install chromium",
    "appwrite:provision": "node scripts/provision-appwrite.mjs",
    "eas:android": "npx eas-cli build --platform android --profile production --non-interactive",
    "eas:submit": "npx eas-cli submit --platform android --profile production --non-interactive"
  },
  "overrides": {
    "expo-file-system": "~57.0.7"
  },
  "private": true
}
